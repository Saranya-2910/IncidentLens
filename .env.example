# Environment Configuration
PROJECT_NAME="IncidentLens"
ENVIRONMENT="development"
DEBUG=false
API_V1_PREFIX="/api/v1"
EVENT_RETENTION_DAYS=30

# Security & Auth
SECRET_KEY="change-this-in-production-use-a-32-byte-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Database (Postgres + pgvector)
# Async driver for FastAPI (asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/incidentlens"
# Sync driver for Alembic & background tasks (psycopg)
DATABASE_SYNC_URL="postgresql+psycopg://postgres:postgres@localhost:5432/incidentlens"

# Background Tasks & Redis
# Use "celery" with Redis + Celery worker, or "inline" for free single-container hosting (Render Free)
TASK_DISPATCH_MODE="celery"
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# AI & LLM (Backend only)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIMENSION=768
SIMILARITY_THRESHOLD=0.45
